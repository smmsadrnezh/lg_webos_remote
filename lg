class LgError(Exception):
    """A problem to tell the user about, without a traceback."""


class NoAnswer(LgError):
    """The TV did not answer in time."""


# ------------------------------- the TV's API ------------------------------ #

class WebSocket:
    """A websocket client: the little lg needs of one (text messages, client
    side, no extensions), since Python has none built in."""

    def __init__(self, host, port, path="/", secure=True):
        try:
            sock = socket.create_connection((host, port), timeout=TIMEOUT)
            if secure:
                context = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
                context.check_hostname = False
                context.verify_mode = ssl.CERT_NONE  # the TV's certificate is self-signed
                sock = context.wrap_socket(sock, server_hostname=host)
        except OSError as e:
            raise LgError(f"cannot reach the TV at {host} ({e.strerror or e}). "
                          "Is it plugged in and on this network?") from None
        self.sock, self.buffer = sock, b""
        try:
            self._upgrade(f"{host}:{port}", path)
        except BaseException:
            self.close()
            raise

    def __enter__(self):
        return self

    def __exit__(self, *_):
        self.close()

    def close(self):
        try:
            self._send_frame(0x8, b"\x03\xe8")  # close, "normal closure"
        except OSError:
            pass
        self.sock.close()

    def waiting(self):
        """Whether data from the TV has arrived but not been read yet."""
        return bool(self.buffer) or (isinstance(self.sock, ssl.SSLSocket)
                                     and self.sock.pending() > 0)

    def send(self, text):
        self._send_frame(0x1, text.encode())

    def receive(self):
        """Wait for the next text message."""
        message = b""
        while True:
            first, second = self._read(2)
            opcode, size = first & 0x0F, second & 0x7F
            if size >= 126:
                size = int.from_bytes(self._read(2 if size == 126 else 8), "big")
            mask = self._read(4) if second & 0x80 else b""
            data = self._read(size)
            if mask:
                data = bytes(b ^ mask[i % 4] for i, b in enumerate(data))
            if opcode == 0x8:
                raise self._closed()
            if opcode == 0x9:
                self._send_frame(0xA, data)  # answer a ping
            elif opcode in (0x0, 0x1):
                message += data
                if first & 0x80:
                    return message.decode(errors="replace")

    def _closed(self):
        return LgError("the TV closed the connection")

    def _upgrade(self, host, path):
        nonce = base64.b64encode(os.urandom(16)).decode()
        self.sock.sendall((f"GET {path} HTTP/1.1\r\nHost: {host}\r\n"
                           "Upgrade: websocket\r\nConnection: Upgrade\r\n"
                           f"Sec-WebSocket-Key: {nonce}\r\nSec-WebSocket-Version: 13\r\n\r\n"
                           ).encode())
        while b"\r\n\r\n" not in self.buffer:
            self._fill()
        head, self.buffer = self.buffer.split(b"\r\n\r\n", 1)
        status = head.split(b"\r\n", 1)[0].decode(errors="replace")
        if " 101 " not in status + " ":
            raise LgError(f"the TV did not accept the connection ({status})")

    def _send_frame(self, opcode, data):
        size = len(data)
        if size < 126:
            header = bytes([0x80 | opcode, 0x80 | size])
        elif size < 1 << 16:
            header = bytes([0x80 | opcode, 0x80 | 126]) + size.to_bytes(2, "big")
        else:
            header = bytes([0x80 | opcode, 0x80 | 127]) + size.to_bytes(8, "big")
        mask = os.urandom(4)  # clients must mask what they send
        self.sock.sendall(header + mask + bytes(b ^ mask[i % 4] for i, b in enumerate(data)))

    def _fill(self):
        try:
            data = self.sock.recv(65536)
        except TimeoutError:
            raise NoAnswer("the TV stopped answering") from None
        except OSError as e:
            raise LgError(f"lost the connection to the TV ({e.strerror or e})") from None
        if not data:
            raise self._closed()
        self.buffer += data

    def _read(self, size):
        while len(self.buffer) < size:
            self._fill()
        data, self.buffer = self.buffer[:size], self.buffer[size:]
        return data


class TV(WebSocket):
    """The TV's command API (SSAP), paired on connecting."""

    def __init__(self, ip, key=None):
        self.key, self.prompted, self.count = None, False, 0
        super().__init__(ip, PORT)
        try:
            self.key = self._register(key)
        except BaseException:
            self.close()
            raise

    def message(self):
        return json.loads(self.receive())

    def send_request(self, uri, payload=None, kind="request"):
        """Send a request (or a subscription) without waiting; returns its id."""
        self.count += 1
        message = {"type": kind, "id": str(self.count), "uri": "ssap://" + uri}
        if payload is not None:
            message["payload"] = payload
        self.send(json.dumps(message))
        return message["id"]

    def request(self, uri, payload=None):
        """Call ssap://URI on the TV and return the reply's payload."""
        id = self.send_request(uri, payload)
        while True:
            reply = self.message()
            if reply.get("id") == id:
                return self.result(reply)

    @staticmethod
    def result(reply):
        result = reply.get("payload") or {}
        if reply.get("type") == "error" or result.get("returnValue") is False:
            raise LgError("the TV refused: " + (result.get("errorText")
                                                or reply.get("error") or "no reason given"))
        return result

    def pointer(self):
        """Open the socket that takes remote control buttons and pointer moves."""
        path = self.request("com.webos.service.networkinput/getPointerInputSocket")
        url = urlparse(path["socketPath"])
        secure = url.scheme == "wss"
        return Pointer(url.hostname, url.port or (3001 if secure else 3000), url.path, secure)

    def _register(self, key):
        payload = {"forcePairing": False, "pairingType": "PROMPT",
                   "manifest": {"manifestVersion": 1, "appVersion": "1.1",
                                "permissions": PERMISSIONS}}
        if key:
            payload["client-key"] = key
        self.send(json.dumps({"type": "register", "id": "register", "payload": payload}))
        while True:
            reply = self.message()
            if reply.get("type") == "registered":
                self.sock.settimeout(TIMEOUT)
                return reply["payload"]["client-key"]
            if reply.get("type") == "error":
                raise LgError(f"the TV refused to pair: {reply.get('error')}")
            if (reply.get("payload") or {}).get("pairingType") == "PROMPT":
                print("Accept the pairing request on the TV with its remote control...",
                      file=sys.stderr, flush=True)
                self.prompted = True
                self.sock.settimeout(PAIR_TIMEOUT)

    def _closed(self):
        """The error for the TV hanging up, which before pairing has a likely cause."""
        if self.key:
            return LgError("the TV closed the connection")
        if self.prompted:
            return LgError("the pairing request was declined on the TV")
        # In standby the TV still accepts connections, then hangs up.
        return LgError('the TV is off or still starting up. Turn it on with "lg on".')


class Pointer(WebSocket):
    """The TV's pointer socket: remote control buttons and the on-screen pointer."""

    def button(self, name):
        self.send(f"type:button\nname:{name}\n\n")

    def move(self, dx, dy):
        self.send(f"type:move\ndx:{dx}\ndy:{dy}\ndown:0\n\n")

    def click(self):
        self.send("type:click\n\n")

    def scroll(self, dy):
        self.send(f"type:scroll\ndx:0\ndy:{dy}\n\n")


def list_inputs(tv):
    devices = tv.request("tv/getExternalInputList").get("devices", [])
    return [(d["id"], d.get("label") or d["id"]) for d in devices]


def list_apps(tv):
    apps = tv.request("com.webos.applicationManager/listApps").get("apps", [])
    apps = [(a["id"], a.get("title") or a["id"]) for a in apps if a.get("visible", True)]
    return sorted(apps, key=lambda app: app[1].lower())


LISTS = {"input": list_inputs, "app": list_apps}


def is_youtube(url):
    host = urlparse(url).hostname or ""
    return host == "youtu.be" or host == "youtube.com" or host.endswith(".youtube.com")


# --------------------------- config and network ---------------------------- #

def load_config():
    try:
        with open(CONFIG) as f:
            return json.load(f)
    except FileNotFoundError:
        return {}
    except (OSError, ValueError) as e:
        raise LgError(f"cannot read {CONFIG}: {e}") from None


def save_config(config):
    os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
    # The pairing key lets anyone on the network control the TV: keep it private.
    with os.fdopen(os.open(CONFIG, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
        json.dump(config, f, indent=2)


def connect(config):
    if not config.get("ip"):
        raise LgError('no TV is set up yet: run "lg setup"')
    tv = TV(config["ip"], config.get("key"))
    if tv.key != config.get("key"):  # paired again: remember the new key
        config["key"] = tv.key
        save_config(config)
    return tv


def wake(ip, mac):
    """Send a Wake-on-LAN packet, which turns on a TV that is in standby."""
    if not mac:
        raise LgError("the TV's hardware (MAC) address is unknown, so it cannot be "
                      'turned on remotely. Run "lg setup" while the TV is on.')
    packet = b"\xff" * 6 + bytes.fromhex(mac.replace(":", "")) * 16
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
        s.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        # Everyone on this link, and the TV's /24 network for good measure.
        for target in ("255.255.255.255", ip.rsplit(".", 1)[0] + ".255"):
            try:
                s.sendto(packet, (target, 9))
            except OSError:
                pass


def neighbours():
    """IP and hardware address of the hosts this computer has talked to lately."""
    try:
        with open("/proc/net/arp") as f:
            rows = [line.split() for line in f.readlines()[1:]]
    except OSError:
        return {}
    return {row[0]: row[3] for row in rows if len(row) > 3 and row[3] != "00:00:00:00:00:00"}


def port_open(ip):
    try:
        socket.create_connection((ip, PORT), timeout=0.5).close()
        return True
    except OSError:
        return False


def discover():
    """LG TVs on the local network, as {ip: (name, awake)}."""
    found = {}
    query = ('M-SEARCH * HTTP/1.1\r\nHOST: 239.255.255.250:1900\r\nMAN: "ssdp:discover"\r\n'
             "MX: 2\r\nST: urn:schemas-upnp-org:device:MediaRenderer:1\r\n\r\n").encode()
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
        s.settimeout(0.5)
        s.sendto(query, ("239.255.255.250", 1900))
        deadline = time.monotonic() + 3
        while time.monotonic() < deadline:
            try:
                reply, (ip, _) = s.recvfrom(4096)
            except TimeoutError:
                continue
            if b"LG" in reply:
                name = re.search(rb"DLNADeviceName\.lge\.com:(.*)", reply)
                found[ip] = (unquote(name.group(1).decode(errors="replace").strip())
                             if name else "LG TV", True)
    # A TV in standby does not answer the search but keeps its API port open.
    for ip in neighbours():
        if ip not in found and port_open(ip):
            found[ip] = ("LG TV, in standby", False)
    return found


def pair(config, ip, asleep=False):
    """Pair with the TV at IP and make it the TV lg controls."""
    same_tv = config.get("ip") == ip
    mac = neighbours().get(ip) or (config.get("mac") if same_tv else None)
    if asleep and mac:  # the pairing prompt needs the screen on
        wake(ip, mac)
        time.sleep(5)
    with TV(ip, config.get("key") if same_tv else None) as tv:
        config.update(ip=ip, mac=neighbours().get(ip) or mac, key=tv.key)
    save_config(config)
    return f"Paired with the TV at {ip}."


# ------------------------------ the commands ------------------------------- #

def execute(config, command, arg=""):
    """Run one of the commands in the usage above; returns what to tell the user."""
    if command not in COMMANDS:
        raise LgError(f'unknown command "{command}" (see "lg help")')
    needs = {"open": "an address", "notify": "a message", "type": "some text",
             "button": "a button name, such as HOME, BACK, UP or ENTER"}
    if command in needs and not arg:
        raise LgError(f"{command} needs {needs[command]}")
    if command == "volume" and arg not in ("", "up", "down") and not (
            arg.isdigit() and int(arg) <= 100):
        raise LgError("the volume is a number from 0 to 100, up or down")
    if command == "on":
        wake(config.get("ip", ""), config.get("mac"))
        return "Sent the wake-up signal. The TV should turn on in a few seconds."

    with connect(config) as tv:
        if command in SIMPLE:
            uri, payload, done = SIMPLE[command]
            tv.request(uri, payload)
            return done
        if command in LISTS and not arg:
            return "\n".join(f"{id:<32} {name}" for id, name in LISTS[command](tv))
        if command == "volume":
            if arg in ("up", "down"):
                tv.request("audio/volume" + arg.capitalize())
            elif arg:
                tv.request("audio/setVolume", {"volume": int(arg)})
            status = tv.request("audio/getVolume")
            status = status.get("volumeStatus", status)  # its shape varies by webOS version
            muted = status.get("muteStatus", status.get("muted"))
            return f"Volume {status.get('volume')}{', muted' if muted else ''}."
        if command == "input":
            tv.request("tv/switchInput", {"inputId": arg})
            return f"Switched to {arg}."
        if command == "app":
            tv.request("system.launcher/launch", {"id": arg})
            return f"Started {arg}."
        if command == "open":
            url = arg if "://" in arg else "https://" + arg
            if is_youtube(url):
                tv.request("system.launcher/launch",
                           {"id": "youtube.leanback.v4", "params": {"contentTarget": url}})
                return "Opened in the YouTube app."
            tv.request("system.launcher/open", {"target": url})
            return "Opened in the TV's web browser."
        if command == "notify":
            tv.request("system.notifications/createToast", {"message": arg})
            return "Message shown on the TV."
        if command == "button":
            with tv.pointer() as pointer:
                pointer.button(arg.upper())
            return f"Pressed {arg.upper()}."
        if command == "type":
            # The TV only answers once a text field has taken the text.
            tv.sock.settimeout(3)
            try:
                tv.request("com.webos.service.ime/insertText", {"text": arg, "replace": False})
            except NoAnswer:
                raise LgError("no text field is selected on the TV") from None
            return "Typed."


def setup_command(config, args):
    if args:
        ip, asleep = args[0], False
    else:
        print("Looking for LG TVs on the network...", file=sys.stderr)
        tvs = discover()
        if len(tvs) != 1:
            listing = "".join(f"\n  {ip}  {name}" for ip, (name, _) in tvs.items())
            raise LgError("found more than one TV; run \"lg setup IP\" with one of:" + listing
                          if tvs else "found no TV. Turn it on, or run \"lg setup IP\"")
        [(ip, (name, awake))] = tvs.items()
        asleep = not awake
        print(f"Found {name} at {ip}.", file=sys.stderr)
    return pair(config, ip, asleep)


