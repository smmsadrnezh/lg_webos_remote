class UI:
    """Boxes drawn by whiptail or dialog, which take nearly the same options."""

    def __init__(self, tool):
        self.tool = tool

    def _show(self, *args):
        """Show a box; returns the user's answer, or None if they cancelled."""
        common = ["--backtitle", TITLE]
        if self.tool == "dialog":
            common.append("--cr-wrap")  # keep the line breaks in our texts
        result = subprocess.run([self.tool, *common, *args], stderr=subprocess.PIPE, text=True)
        return result.stderr.strip() if result.returncode == 0 else None

    def _size(self):
        size = shutil.get_terminal_size()
        return size.lines, min(76, size.columns - 2)

    def menu(self, title, prompt, items, default=None):
        rows, width = self._size()
        extra = prompt.count("\n")
        height = max(1, min(len(items), rows - 9 - extra))
        options = ["--title", title] + (["--default-item", default] if default else [])
        return self._show(*options, "--menu", prompt, str(height + 8 + extra), str(width),
                          str(height), *[part for item in items for part in item])

    def ask(self, title, prompt):
        return self._show("--title", title, "--inputbox", prompt, "10", str(self._size()[1]), "")

    def tell(self, title, text):
        rows, width = self._size()
        lines = sum(len(line) // (width - 4) + 1 for line in text.split("\n"))
        scroll = ["--scrolltext"] if self.tool == "whiptail" else []
        self._show("--title", title, *scroll, "--msgbox", text,
                   str(min(rows - 2, lines + 7)), str(width))

    def confirm(self, title, text):
        return self._show("--title", title, "--yesno", text, "10", str(self._size()[1])) is not None


POWER = [("on", "Turn the TV on"), ("off", "Turn the TV off"),
         ("screen-on", "Turn the screen on"),
         ("screen-off", "Turn the screen off (the sound keeps playing)")]
VOLUME = [("up", "Volume up"), ("down", "Volume down"), ("set", "Set the volume..."),
          ("mute", "Mute"), ("unmute", "Unmute")]
MEDIA = [("play", "Play"), ("pause", "Pause"), ("stop", "Stop"),
         ("rewind", "Rewind"), ("forward", "Fast forward")]


def interactive(config):
    tool = os.environ.get("LG_UI") or next(
        (t for t in ("whiptail", "dialog") if shutil.which(t)), None)
    if not tool:
        raise LgError("the menu needs whiptail or dialog: sudo apt install whiptail")
    ui = UI(tool)

    def attempt(action):
        """Run an action that talks to the TV; show what went wrong, if anything."""
        print("Talking to the TV...", file=sys.stderr, flush=True)
        try:
            return action()
        except LgError as e:
            ui.tell("Error", str(e)[:1].upper() + str(e)[1:])
            return None

    def submenu(title, items):
        note, choice = None, None
        while True:
            prompt = (note + "\n\n" if note else "") + "Choose an action:"
            choice = ui.menu(title, prompt, items, choice)
            if choice is None:
                return None
            if choice == "set":
                level = ui.ask("Set Volume", "Volume level, from 0 to 100:")
                if not level:
                    continue
                command, arg = "volume", level
            elif choice in ("up", "down"):
                command, arg = "volume", choice
            else:
                command, arg = choice, ""
            note = attempt(lambda: execute(config, command, arg)) or note

    def choose(kind, title):
        def fetch():
            with connect(config) as tv:
                return LISTS[kind](tv)
        found = attempt(fetch)
        if not found:
            if found is not None:
                ui.tell(title, f"The TV did not list any {kind}s.")
            return None
        if kind == "app":  # list app names; the ids are long and mean little
            ids = {name: id for id, name in reversed(found)}
            found = [(name, id) for id, name in found]
        choice = ui.menu(title, f"Choose an {kind}:", found)
        if choice is None:
            return None
        target = ids[choice] if kind == "app" else choice
        return attempt(lambda: execute(config, kind, target))

    def type_in(command, title, prompt):
        text = ui.ask(title, prompt)
        return attempt(lambda: execute(config, command, text)) if text else None

    def setup():
        print("Looking for LG TVs on the network...", file=sys.stderr, flush=True)
        tvs = discover()
        items = [(ip, name) for ip, (name, _) in tvs.items()]
        items.append(("other", "Enter the TV's IP address"))
        prompt = ("Choose your TV:" if tvs else
                  "No TV answered. Turn the TV on and try again, or enter its IP address.")
        ip = ui.menu("Set Up TV", prompt, items)
        if ip == "other":
            ip = ui.ask("Set Up TV", "The TV's IP address (in the TV's network settings):")
        if not ip:
            return None
        asleep = ip in tvs and not tvs[ip][1]
        print(f"Pairing with the TV at {ip}...", file=sys.stderr, flush=True)
        return attempt(lambda: pair(config, ip, asleep))

    actions = {
        "1": ("Remote Control (keyboard and mouse)", lambda: attempt(lambda: remote(config))),
        "2": ("Power", lambda: submenu("Power", POWER)),
        "3": ("Volume", lambda: submenu("Volume", VOLUME)),
        "4": ("Media", lambda: submenu("Media", MEDIA)),
        "5": ("Inputs", lambda: choose("input", "Inputs")),
        "6": ("Apps", lambda: choose("app", "Apps")),
        "7": ("Open URL", lambda: type_in(
            "open", "Open URL", "Address to open (YouTube links open in the YouTube app):")),
        "8": ("Send Message", lambda: type_in(
            "notify", "Send Message", "Message to show on the TV:")),
        "9": ("Set Up TV", setup),
    }

    if not config.get("ip") and ui.confirm(
            "Set Up TV", "No TV is set up yet.\n\nFind your LG TV on the network and pair "
                         "with it now? Keep the TV on and its remote at hand."):
        setup()
    note, choice = None, None
    while True:
        prompt = (note + "\n\n" if note else "") + "Choose what to do:"
        choice = ui.menu(TITLE, prompt, [(key, name) for key, (name, _) in actions.items()],
                         choice)
        if choice is None:
            return
        note = actions[choice][1]()


def main(args):
    try:
        config = load_config()
        if not args:
            interactive(config)
        elif args[0] in ("help", "-h", "--help"):
            print(__doc__.strip())
        elif args[0] == "setup":
            print(setup_command(config, args[1:]))
        elif args[0] == "remote":
            remote(config)
        else:
            print(execute(config, args[0], " ".join(args[1:])))
    except LgError as e:
        print(f"lg: {e}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
