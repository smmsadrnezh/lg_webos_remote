class Remote:
    """Turns the terminal's keys and mouse events into input for the TV."""

    TOKENS = re.compile(r"\x1b\[<\d+;\d+;\d+[Mm]|\x1b\[[0-9;?$]*[A-Za-z~]|\x1bO[A-Za-z]|\x1b|.",
                        re.S)
    MOUSE = re.compile(r"\x1b\[<(\d+);(\d+);(\d+)([Mm])")

    def __init__(self, tv, pointer):
        self.tv, self.pointer = tv, pointer
        self.typing = False
        self.keyboard = None   # id of the subscription to the TV's keyboard
        self.tv_typing = None  # whether the TV's keyboard is open, as it last said
        self.mouse = None      # where the mouse was in the window
        self.pixels = False    # whether the terminal reports the mouse in pixels
        self.moved = [0, 0]    # pointer movement not sent yet
        self.note = "Ready."

    def run(self):
        self.keyboard = self.tv.send_request("com.webos.service.ime/registerRemoteKeyboard",
                                             kind="subscribe")
        fd = sys.stdin.fileno()
        saved = termios.tcgetattr(fd)
        decoder = codecs.getincrementaldecoder("utf-8")(errors="replace")
        try:
            tty.setcbreak(fd)
            # Alternate screen, no cursor, every mouse event in SGR format, in
            # pixels where the terminal can (and ask whether it can).
            self.write("\x1b[?1049h\x1b[?25l\x1b[?1003h\x1b[?1006h\x1b[?1016h\x1b[?1016$p")
            self.draw()
            while True:
                if self.tv.waiting():
                    self.from_tv(self.tv.message())
                    continue
                if self.pointer.waiting():
                    self.pointer.receive()
                    continue
                ready = select.select([fd, self.tv.sock, self.pointer.sock], [], [])[0]
                if self.tv.sock in ready:
                    self.from_tv(self.tv.message())
                if self.pointer.sock in ready:
                    self.pointer.receive()
                if fd in ready and not self.from_terminal(decoder.decode(os.read(fd, 4096))):
                    return
        except KeyboardInterrupt:
            return
        finally:
            self.write("\x1b[?1016l\x1b[?1006l\x1b[?1003l\x1b[?25h\x1b[?1049l")
            termios.tcsetattr(fd, termios.TCSADRAIN, saved)

    def from_terminal(self, text):
        """Act on what the terminal sent; returns False to quit."""
        typed = ""
        for token in self.TOKENS.findall(text):
            if self.typing and len(token) == 1 and token.isprintable():
                typed += token
                continue
            if typed:
                self.type(typed)
                typed = ""
            mouse = self.MOUSE.fullmatch(token)
            if mouse:
                self.from_mouse(int(mouse[1]), int(mouse[2]), int(mouse[3]), mouse[4] == "M")
                continue
            self.send_moves()
            if token.startswith("\x1b[?1016;"):  # the answer about pixels: 1 or 3 is yes
                self.pixels = token[8:9] in ("1", "3")
            elif token == "\t":
                self.set_typing(not self.typing)
            elif self.typing and token == "\x1b":
                self.set_typing(False)
            elif self.typing and token in ("\x7f", "\x08"):
                self.tv.send_request("com.webos.service.ime/deleteCharacters", {"count": 1})
                self.show("Deleted a character.")
            elif self.typing and token in ("\n", "\r"):
                self.tv.send_request("com.webos.service.ime/sendEnterKey")
                self.set_typing(False, "Sent Enter.")
            elif token == "q" and not self.typing:
                return False
            elif token in KEYS:
                self.pointer.button(KEYS[token])
                self.show(f"Pressed {KEYS[token]}.")
        if typed:
            self.type(typed)
        self.send_moves()
        return True

    def from_mouse(self, code, x, y, pressed):
        width, height, columns, rows = self.window()
        if not self.pixels and (x > columns + 1 or y > rows + 1):
            self.pixels, self.mouse = True, None  # it reports pixels without saying so
        if not self.pixels:
            width, height = columns, rows
        if code & 64:  # the wheel: 64 is up, 65 down
            self.send_moves()
            self.pointer.scroll(1 if code & 1 else -1)
        elif code & 32:  # the mouse moved
            if self.mouse:
                self.moved[0] += (x - self.mouse[0]) * TV_WIDTH / width
                self.moved[1] += (y - self.mouse[1]) * TV_HEIGHT / height
        elif pressed:
            self.send_moves()
            button = code & 3
            if button == 0:
                self.pointer.click()
                self.show("Clicked.")
            elif button == 2:
                self.pointer.button("BACK")
                self.show("Pressed BACK.")
        self.mouse = (x, y)

    def send_moves(self):
        dx, dy = round(self.moved[0]), round(self.moved[1])
        if dx or dy:
            self.pointer.move(dx, dy)
            self.moved = [self.moved[0] - dx, self.moved[1] - dy]

    def type(self, text):
        self.tv.send_request("com.webos.service.ime/insertText", {"text": text, "replace": False})
        self.show(f"Typed: {text}")

    def from_tv(self, message):
        if message.get("id") == self.keyboard:
            # The TV reports on its keyboard often; follow it only when it opens
            # or closes, so that Tab and Esc can override it in between.
            widget = (message.get("payload") or {}).get("currentWidget") or {}
            if "focus" in widget and bool(widget["focus"]) != self.tv_typing:
                self.tv_typing = bool(widget["focus"])
                self.set_typing(self.tv_typing, "The TV's keyboard opened."
                                if self.tv_typing else "The TV's keyboard closed.")
        elif message.get("type") == "error":
            self.show("The TV refused: " + str(message.get("error")))

    def set_typing(self, on, note=None):
        self.typing = on
        self.show(note or ("Typing into the TV." if on else "Stopped typing."))

    def window(self):
        """The terminal's size: width and height in pixels, then columns and rows."""
        rows, columns, width, height = struct.unpack(
            "HHHH", fcntl.ioctl(sys.stdout.fileno(), termios.TIOCGWINSZ, b"\0" * 8))
        return width or columns * 10, height or rows * 20, columns, rows

    def draw(self):
        self.write("\x1b[2J\x1b[H" + REMOTE_HELP.replace("\n", "\r\n"))
        self.show(self.note)

    def show(self, note):
        self.note = note
        mode = "TYPING (Tab or Esc to stop)" if self.typing else "remote"
        rows = self.window()[3]
        self.write(f"\x1b[{rows};1H\x1b[2K  [{mode}]  {note}"[:400])

    @staticmethod
    def write(text):
        sys.stdout.write(text)
        sys.stdout.flush()


def remote(config):
    """Control the TV with this computer's keyboard and mouse, until q is pressed."""
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        raise LgError("the remote needs a terminal")
    with connect(config) as tv, tv.pointer() as pointer:
        Remote(tv, pointer).run()


